{#
/**
 * @file
 * Theme override for a link to a file.
 *
 * Adds the file type (extension) and size as separate, styleable elements.
 * Their visibility is controlled by CSS (see css/paragraphs/downloads.css):
 * the "Documents à télécharger" paragraph toggles them with its
 * show_file_type / show_file_size options.
 *
 * Available variables:
 * - attributes: The HTML attributes for the containing element.
 * - link: A link to the file.
 * - file_size: The size of the file.
 * - file: The file entity.
 */
#}
{% set filename_parts = file ? file.getFilename()|split('.') : [] %}
{% set file_extension = filename_parts|length > 1 ? filename_parts|last|upper : '' %}
<span{{ attributes }}>{{ link }}</span>
{% if file_extension or file_size %}
  <span class="file__meta">
    {%- if file_extension -%}
      <span class="file__type">{{ file_extension }}</span>
    {%- endif -%}
    {%- if file_size -%}
      <span class="file__size">{{ file_size }}</span>
    {%- endif -%}
  </span>
{% endif %}
